{
  "format_version": "1.8.0",
  "animations": {
    "idle": {
      "loop": true,
      "animation_length": 2,
      "bones": {}
    },
    "drive": {
      "loop": true,
      "animation_length": 1,
      "bones": {
        "propeller": {
          "rotation": [
            0,
            0,
            "query.anim_time * 720"
          ]
        },
        "rudder": {
          "rotation": [
            0,
            "math.sin(query.anim_time * 180) * 5",
            0
          ]
        }
      }
    }
  }
}
