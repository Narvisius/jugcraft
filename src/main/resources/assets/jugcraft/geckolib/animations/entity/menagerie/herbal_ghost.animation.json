{
  "format_version": "1.8.0",
  "animations": {
    "idle": {
      "loop": true,
      "animation_length": 2,
      "bones": {
        "root": {
          "position": [
            0,
            "math.sin(query.anim_time * 180) * 0.5",
            0
          ]
        }
      }
    },
    "walk": {
      "loop": true,
      "animation_length": 1,
      "bones": {
        "left": {
          "rotation": [
            "math.sin(query.anim_time * 360) * 25",
            0,
            0
          ]
        },
        "right": {
          "rotation": [
            "math.sin(query.anim_time * 360) * -25",
            0,
            0
          ]
        }
      }
    }
  }
}
