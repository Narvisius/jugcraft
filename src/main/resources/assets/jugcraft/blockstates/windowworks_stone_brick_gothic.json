{
  "multipart": [
    {
      "when": {
        "AND": [
          {
            "facing": "east|west",
            "part": "top"
          }
        ]
      },
      "apply": {
        "model": "jugcraft:newest/windowworks/block/gothic/stone_brick_gothic_tall_top"
      }
    },
    {
      "when": {
        "AND": [
          {
            "facing": "north|south",
            "part": "top"
          }
        ]
      },
      "apply": {
        "model": "jugcraft:newest/windowworks/block/gothic/stone_brick_gothic_tall_top",
        "y": 90
      }
    },
    {
      "when": {
        "AND": [
          {
            "facing": "east|west",
            "part": "middle"
          }
        ]
