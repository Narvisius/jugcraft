          }
        ]
      },
      "apply": {
        "model": "jugcraft:newest/windowworks/block/gothic/stone_brick_gothic_tall_middle",
        "y": 90
      }
    },
    {
      "when": {
        "AND": [
          {
            "facing": "east|west",
            "part": "bottom"
