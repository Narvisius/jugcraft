{
  "multipart": [
    {
      "apply": {
        "model": "jugcraft:newest/fenceworks/block/hedges/cherry_wall_post"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "jugcraft:newest/fenceworks/block/hedges/cherry_wall_side_tall",
        "uvlock": false
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "jugcraft:newest/fenceworks/block/hedges/cherry_wall_side_tall",
        "y": 90,
        "uvlock": false
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "jugcraft:newest/fenceworks/block/hedges/cherry_wall_side_tall",
        "y": 180,
        "uvlock": false
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "jugcraft:newest/fenceworks/block/hedges/cherry_wall_side_tall",
        "y": 270,
        "uvlock": false
      }
    },
    {
      "apply": {
        "model": "jugcraft:block/diagonal/fenceworks_cherry_hedge"
      },
      "when": {
        "north_east": "true"
      }
    },
    {
      "apply": {
        "model": "jugcraft:block/diagonal/fenceworks_cherry_hedge",
        "y": 90
      },
      "when": {
        "south_east": "true"
      }
    },
    {
      "apply": {
        "model": "jugcraft:block/diagonal/fenceworks_cherry_hedge",
        "y": 180
      },
      "when": {
        "south_west": "true"
      }
    },
    {
      "apply": {
        "model": "jugcraft:block/diagonal/fenceworks_cherry_hedge",
        "y": 270
      },
      "when": {
        "north_west": "true"
      }
    }
  ]
}
