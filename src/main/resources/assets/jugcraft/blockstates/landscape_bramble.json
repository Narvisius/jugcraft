{
  "multipart": [
    {
      "apply": {
        "model": "jugcraft:menagerie/landscape/block/bramble"
      }
    },
    {
      "when": {
        "north": true
      },
      "apply": {
        "model": "jugcraft:menagerie/landscape/block/bramble_side"
      }
    },
    {
      "when": {
        "east": true
      },
      "apply": {
        "model": "jugcraft:menagerie/landscape/block/bramble_side",
        "y": 90,
        "uvlock": true
      }
    },
    {
      "when": {
        "south": true
      },
      "apply": {
        "model": "jugcraft:menagerie/landscape/block/bramble_side",
        "y": 180,
        "uvlock": true
      }
    },
    {
      "when": {
        "west": true
      },
      "apply": {
        "model": "jugcraft:menagerie/landscape/block/bramble_side",
        "y": 270,
        "uvlock": true
      }
    },
    {
      "when": {
        "up": true
      },
      "apply": {
        "model": "jugcraft:menagerie/landscape/block/bramble_side",
        "x": 270,
        "uvlock": true
      }
    },
    {
      "when": {
        "down": true
      },
      "apply": {
        "model": "jugcraft:menagerie/landscape/block/bramble_side",
        "x": 90,
        "uvlock": true
      }
    }
  ]
}
