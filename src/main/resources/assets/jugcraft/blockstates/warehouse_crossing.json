{
  "multipart": [
    {
      "when": {
        "axis": "x",
        "soffit": "none"
      },
      "apply": {
        "model": "jugcraft:block/warehouse_crossing_x"
      }
    },
    {
      "when": {
        "axis": "x",
        "soffit": "deck_x|deck_z|girder_z|girder_x"
      },
      "apply": {
        "model": "jugcraft:block/warehouse_crossing_x_top"
      }
    },
    {
      "when": {
        "axis": "z",
        "soffit": "none"
      },
      "apply": {
        "model": "jugcraft:block/warehouse_crossing_z"
      }
    },
    {
      "when": {
        "axis": "z",
        "soffit": "deck_x|deck_z|girder_z|girder_x"
      },
      "apply": {
        "model": "jugcraft:block/warehouse_crossing_z_top"
      }
    },
    {
      "when": {
        "soffit": "deck_x"
      },
      "apply": {
        "model": "jugcraft:block/warehouse_soffit_deck"
      }
    },
    {
      "when": {
        "soffit": "deck_z"
      },
      "apply": {
        "model": "jugcraft:block/warehouse_soffit_deck",
        "y": 90
      }
    },
    {
      "when": {
        "soffit": "girder_z"
      },
      "apply": {
        "model": "jugcraft:block/warehouse_soffit_girder"
      }
    },
    {
      "when": {
        "soffit": "girder_x"
      },
      "apply": {
        "model": "jugcraft:block/warehouse_soffit_girder",
        "y": 90
      }
    }
  ]
}
