{
  "multipart": [
    {
      "when": {
        "post": "true"
      },
      "apply": {
        "model": "jugcraft:block/railing_post"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "jugcraft:block/railing_arm"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "jugcraft:block/railing_arm",
        "y": 90
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "jugcraft:block/railing_arm",
        "y": 180
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "jugcraft:block/railing_arm",
        "y": 270
      }
    }
  ]
}
