{
  "multipart": [
    {
      "apply": {
        "model": "jugcraft:block/fluid_valve_core"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "jugcraft:block/fluid_valve_arm"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "jugcraft:block/fluid_valve_arm",
        "y": 90
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "jugcraft:block/fluid_valve_arm",
        "y": 180
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "jugcraft:block/fluid_valve_arm",
        "y": 270
      }
    },
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "jugcraft:block/fluid_valve_arm",
        "x": 270
      }
    },
    {
      "when": {
        "down": "true"
      },
      "apply": {
        "model": "jugcraft:block/fluid_valve_arm",
        "x": 90
      }
    },
    {
      "when": {
        "powered": "false"
      },
      "apply": {
        "model": "jugcraft:block/fluid_valve_open"
      }
    },
    {
      "when": {
        "powered": "true"
      },
      "apply": {
        "model": "jugcraft:block/fluid_valve_closed"
      }
    }
  ]
}
