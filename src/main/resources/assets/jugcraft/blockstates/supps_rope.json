{
  "multipart": [
    {
      "when": {
        "knot": true
      },
      "apply": {
        "model": "jugcraft:newest/supps/block/rope_knot"
      }
    },
    {
      "when": {
        "north": true
      },
      "apply": {
        "model": "jugcraft:newest/supps/block/rope_connection"
      }
    },
    {
      "when": {
        "east": true
      },
      "apply": {
        "model": "jugcraft:newest/supps/block/rope_connection",
        "y": 90
      }
    },
    {
      "when": {
        "south": true
      },
      "apply": {
        "model": "jugcraft:newest/supps/block/rope_connection",
        "y": 180
      }
    },
    {
      "when": {
        "west": true
      },
      "apply": {
        "model": "jugcraft:newest/supps/block/rope_connection",
        "y": 270
      }
    },
    {
      "when": {
        "up": true
      },
      "apply": {
        "model": "jugcraft:newest/supps/block/rope_up"
      }
    },
    {
      "when": {
        "down": true
      },
      "apply": {
        "model": "jugcraft:newest/supps/block/rope_down"
      }
    }
  ]
}
