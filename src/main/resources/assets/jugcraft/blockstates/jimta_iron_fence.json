{
  "multipart": [
    {
      "apply": {
        "model": "jugcraft:block/jimta_iron_fence_post_ends"
      }
    },
    {
      "when": {
        "north": "false",
        "south": "false",
        "east": "false",
        "west": "false"
      },
      "apply": {
        "model": "jugcraft:block/jimta_iron_fence_post"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
