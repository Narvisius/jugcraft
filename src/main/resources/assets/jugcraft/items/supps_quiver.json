              },
              {
                "type": "minecraft:dye",
                "default": 10511680
              }
            ]
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "jugcraft:newest/supps/item/quiver_in_hand_dyed",
