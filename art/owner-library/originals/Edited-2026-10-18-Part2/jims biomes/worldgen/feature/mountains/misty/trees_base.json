{
  "type": "minecraft:tree",
  "below_trunk_provider": {
    "type": "minecraft:rule_based",
    "rules": [
      {
        "if_true": {
          "type": "minecraft:not",
          "predicate": {
            "type": "minecraft:matching_block_tag",
            "tag": "minecraft:cannot_replace_below_tree_trunk"
          }
        },
        "then": {
          "id": "minecraft:dirt"
        }
      }
    ]
  },
  "decorators": [],
  "foliage_placer": {
    "type": "minecraft:pine_foliage_placer",
    "height": 3,
    "offset": 0,
    "radius": {
      "type": "minecraft:uniform",
      "min_inclusive": 2,
      "max_inclusive": 3
    }
  },
  "foliage_provider": {
    "type": "minecraft:simple",
    "state": {
      "id": "minecraft:oak_leaves",
      "properties": {
        "distance": "7",
        "persistent": "false",
        "waterlogged": "false"
      }
    }
  },
  "ignore_vines": true,
  "minimum_size": {
    "type": "minecraft:two_layers_feature_size"
  },
  "trunk_placer": {
    "type": "minecraft:straight_trunk_placer",
    "base_height": 4,
    "height_rand_a": 7,
    "height_rand_b": 9
  },
  "trunk_provider": {
    "type": "minecraft:simple",
    "state": {
      "id": "minecraft:oak_log",
      "properties": {
        "axis": "y"
      }
    }
  }
}
