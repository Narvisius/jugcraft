{
  "multipart": [
    {
      "apply": {
        "model": "cozyhome:block/sandstone_fountain_spout"
      },
      "when": {
        "face": "floor"
      }
    },
    {
      "apply": {
        "model": "cozyhome:block/sandstone_fountain_spout",
        "x": 180
      },
      "when": {
        "face": "ceiling"
      }
    },
    {
      "apply": {
        "model": "cozyhome:block/sandstone_fountain_spout_wall"
      },
      "when": {
        "face": "wall",
        "facing": "north"
      }
    },
    {
      "apply": {
        "model": "cozyhome:block/sandstone_fountain_spout_wall",
        "y": 90
      },
      "when": {
        "face": "wall",
        "facing": "east"
      }
    },
    {
      "apply": {
        "model": "cozyhome:block/sandstone_fountain_spout_wall",
        "y": 180
      },
      "when": {
        "face": "wall",
        "facing": "south"
      }
    },
    {
      "apply": {
        "model": "cozyhome:block/sandstone_fountain_spout_wall",
        "y": 270
      },
      "when": {
        "face": "wall",
        "facing": "west"
      }
    },
    {
      "apply": {
        "model": "cozyhome:block/stream_water_dripping"
      },
      "when": {
        "contains": "water",
        "face": "wall",
        "facing": "north"
      }
    },
    {
      "apply": {
        "model": "cozyhome:block/stream_water_dripping",
        "y": 90
      },
      "when": {
        "contains": "water",
        "face": "wall",
        "facing": "east"
      }
    },
    {
      "apply": {
        "model": "cozyhome:block/stream_water_dripping",
        "y": 180
      },
      "when": {
        "contains": "water",
        "face": "wall",
        "facing": "south"
      }
    },
    {
      "apply": {
        "model": "cozyhome:block/stream_water_dripping",
        "y": 270
      },
      "when": {
        "contains": "water",
        "face": "wall",
        "facing": "west"
      }
    },
    {
      "apply": {
        "model": "cozyhome:block/stream_lava_dripping"
      },
